{
  "name": "turbomusic",
  "version": "1.0.0",
  "description": "Learn songs together as a guitar duet",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "screenshots": "vite build && tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "express": "^5.3.0",
    "opensheetmusicdisplay": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module"
}
